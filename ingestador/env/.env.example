# Plantilla de `env/.env` (este SÍ se versiona; env/.env NO).
# Copia este fichero a `env/.env` y rellena los valores reales:
#     cp env/.env.example env/.env

# ------------------- DATAWAREHOUSE -------------------
# Credenciales del DWH que usa el pipeline: el asset `publish_dwh` lee estas
# variables PG*. PGDWH_SCHEMA es el esquema destino (por defecto "dwh").
PGHOST=<host>
PGPORT=<puerto>
PGDATABASE=<base_de_datos>
PGUSER=<usuario>
PGPASSWORD=<password>
PGDWH_SCHEMA=dwh

# ------------------- SIRE -------------------
# Modo verboso de `sire_details_monthly` y `sire_files_monthly`.
# Apagado por defecto; descomenta para depurar.
# SIRE_VERBOSE=1
# SIRE_DETAILS_VERBOSE=1
# SIRE_FILES_VERBOSE=1
